# Mẫu file .env — COPY thành .env rồi điền key thật (KHÔNG commit .env).
# Lấy key free ở: https://aistudio.google.com/apikey

# --- 1 key ---
GEMMA_API_KEY = "AIza...key_cua_ban"

# --- NHIỀU key (tận dụng nhiều tài khoản Google để vượt trần RPM) ---
# Cách 1: thêm biến có hậu tố _1, _2, _3, ... (tên bắt đầu bằng GEMMA_API_KEY là được)
# GEMMA_API_KEY_1 = "key_tai_khoan_1"
# GEMMA_API_KEY_2 = "key_tai_khoan_2"
# GEMMA_API_KEY_3 = "key_tai_khoan_3"
#
# Cách 2: nhiều key trên 1 dòng, cách nhau dấu phẩy
# GEMMA_API_KEY = "key1,key2,key3,key4"
#
# Code tự gom TẤT CẢ key -> phân phối request round-robin ra từng key.
# Tổng luồng song song = api_max_workers (config) × số key.
# LƯU Ý: dùng nhiều tài khoản để né rate-limit là vùng xám điều khoản Google -> tự cân nhắc.
